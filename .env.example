# Configurações de Email

EMAIL_USER=
EMAIL_PASSWORD=

# Configurações opcionais

IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# Chave da API do Google Gemini
# Obtenha sua chave em: https://aistudio.google.com/

GEMINI_API_KEY=

# URL de Conexão do Banco de Dados PostgreSQL da Render
# Cole aqui a "External Connection String" obtida na Parte 1
DATABASE_URL="postgres://seu_usuario:sua_senha@seu_host.oregon-postgres.render.com/seu_banco"